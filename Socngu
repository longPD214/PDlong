-- 1. Anti Kick Logic
local oldHM
oldHM = hookmetamethod(game, "__namecall", function(self, ...)
   local method = getnamecallmethod()
   if _G.AntiKick and tostring(method):lower() == "kick" and self == LocalPlayer then
      return nil
   end
   return oldHM(self, ...)
end)

