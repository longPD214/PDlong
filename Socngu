-- 3. Bypass Speed & Jump Checks (Xóa Script Check Ngầm)
local function DisableAntiCheatScripts()
   pcall(function()
      for _, v in pairs(game:GetDescendants()) do
         if v:IsA("LocalScript") then
            local name = v.Name:lower()
            if name:find("cheat") or name:find("anticheat") or name:find("speedcheck") or name:find("detector") then
               v.Disabled = true
            end
         end
      end
   end)
end

