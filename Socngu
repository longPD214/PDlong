RunService.RenderStepped:Connect(function()
   pcall(function()
      if _G.LockSpeed and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
         local hum = LocalPlayer.Character.Humanoid
         hum.WalkSpeed = _G.CustomSpeed
         
         hum.UseJumpPower = true
         hum.JumpPower = _G.CustomJump
         hum.JumpHeight = _G.CustomJump / 3.5
      end
   end)
end)

local function TweenTo(targetCFrame)
   if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
      local hrp = LocalPlayer.Character.HumanoidRootPart
      local distance = (hrp.Position - targetCFrame.Position).Magnitude
      local tweenInfo = TweenInfo.new(distance / _G.TweenSpeed, Enum.EasingStyle.Linear)
      local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
      tween:Play()
      return tween
   end
end

local function GetNearestEgg()
   local nearestEgg = nil
   local shortestDistance = math.huge

   if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
      local myPos = LocalPlayer.Character.HumanoidRootPart.Position

      for _, obj in pairs(workspace:GetDescendants()) do
         if obj.Name:lower():find("egg") and (obj:IsA("Model") or obj:IsA("BasePart")) then
            local part = obj:IsA("BasePart") and obj or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if part then
               local dist = (part.Position - myPos).Magnitude
               if dist < shortestDistance then
                  shortestDistance = dist
                  nearestEgg = part
               end
            end
         end
      end
   end
   return nearestEgg
end

local function GetSpecificEggByName(eggName)
   if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
      for _, obj in pairs(workspace:GetDescendants()) do
         if (obj.Name:lower() == eggName:lower() or obj.Name:lower():find(eggName:lower())) and (obj:IsA("Model") or obj:IsA("BasePart")) then
            return obj:IsA("BasePart") and obj or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
         end
      end
   end
   return nil
end

