ESPTab:CreateToggle({
   Name = "Enable Egg ESP Visuals\n(Bật hiệu ứng định vị nhìn xuyên tường tất cả trứng)",
   CurrentValue = false,
   Flag = "EggESPToggle",
   Callback = function(Value)
      _G.EggESP = Value
      
      task.spawn(function()
         while _G.EggESP do
            task.wait(1.5)
            pcall(function()
               for _, obj in pairs(workspace:GetDescendants()) do
                  if obj.Name:lower():find("egg") and (obj:IsA("Model") or obj:IsA("BasePart")) then
                     local targetPart = obj:IsA("BasePart") and obj or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                     
                     if targetPart and not targetPart:FindFirstChild("EggHighlight") then
                        local highlight = Instance.new("Highlight")
                        highlight.Name = "EggHighlight"
                        highlight.Adornee = obj
                        highlight.FillColor = Color3.fromRGB(255, 215, 0)
                        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                        highlight.FillTransparency = 0.4
                        highlight.Parent = targetPart

                        local billboard = Instance.new("BillboardGui")
                        billboard.Name = "EggNameTag"
                        billboard.AlwaysOnTop = true
                        billboard.Size = UDim2.new(0, 100, 0, 30)
                        billboard.StudsOffset = Vector3.new(0, 3, 0)
                        billboard.Parent = targetPart

                        local label = Instance.new("TextLabel")
                        label.Parent = billboard
                        label.Size = UDim2.new(1, 0, 1, 0)
                        label.Text = "🥚 " .. obj.Name
                        label.TextColor3 = Color3.fromRGB(255, 255, 255)
                        label.TextScaled = true
                        label.BackgroundTransparency = 1
                     end
                  end
               end
            end)
         end

         if not _G.EggESP then
            for _, obj in pairs(workspace:GetDescendants()) do
               if obj:FindFirstChild("EggHighlight") then obj.EggHighlight:Destroy() end
               if obj:FindFirstChild("EggNameTag") then obj.EggNameTag:Destroy() end
            end
         end
      end)
   end,
})

