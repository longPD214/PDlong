local function CheckAndGetQuest()
    local level = game.Players.LocalPlayer.Data.Level.Value
    local currentQuest
    for _, data in ipairs(QuestData) do
        if level >= data.MinLvl and level <= data.MaxLvl then
            currentQuest = data
            break
        end
    end

    if currentQuest then
        if _G.AutoQuest and not game:GetService("Players").LocalPlayer.PlayerGui.Main.Quest.Visible then
            local args = {[1] = "StartQuest", [2] = currentQuest.QuestName, [3] = currentQuest.QuestLevel}
            game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer(unpack(args))
        end
        return currentQuest.Mob
    end
    return "Bandit"
end

local function MagnetEnemies(targetPosition)
    for _, enemy in pairs(game:GetService("Workspace").Enemies:GetChildren()) do
        if enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
            if (enemy.HumanoidRootPart.Position - targetPosition).Magnitude <= 350 then
                enemy.HumanoidRootPart.CFrame = CFrame.new(targetPosition)
                enemy.HumanoidRootPart.CanCollide = false
                enemy.Humanoid.WalkSpeed = 0
            end
        end
    end
end

--// Logic Loop
task.spawn(function()
    while task.wait() do
        if _G.AutoFarmLevel then
            pcall(function()
                local targetMobName = CheckAndGetQuest()
                local player = game.Players.LocalPlayer
                local character = player.Character or player.CharacterAdded:Wait()
                local hrp = character:FindFirstChild("HumanoidRootPart")
                
                if hrp then
                    for _, enemy in pairs(game:GetService("Workspace").Enemies:GetChildren()) do
                        if string.find(enemy.Name, targetMobName) and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
                            repeat
                                task.wait()
                                if not _G.AutoFarmLevel then break end
                                CheckAndGetQuest()
                                hrp.CFrame = enemy.HumanoidRootPart.CFrame * CFrame.new(0, 10, 0)
                                MagnetEnemies(enemy.HumanoidRootPart.Position)
                                VirtualUser:CaptureController()
                                VirtualUser:Button1Down(Vector2.new(0, 0))
                            until not enemy or not enemy:FindFirstChild("Humanoid") or enemy.Humanoid.Health <= 0 or not _G.AutoFarmLevel
                        end
                    end
                end
            end)
        end
    end
end)

