-- 4. HÀM TWEEN DỊCH CHUYỂN TỐC ĐỘ 190
local function TweenTo(targetCFrame)
    if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        if getgenv().LongTurboHub.BypassTP then
            LP.Character.HumanoidRootPart.CFrame = targetCFrame
        else
            local dist = (LP.Character.HumanoidRootPart.Position - targetCFrame.Position).Magnitude
            local speed = getgenv().LongTurboHub.TweenSpeed or 190
            local tween = game:GetService("TweenService"):Create(
                LP.Character.HumanoidRootPart,
                TweenInfo.new(dist / speed, Enum.EasingStyle.Linear),
                {CFrame = targetCFrame}
            )
            tween:Play()
        end
    end
end

-- 5. HÀM TÌM QUEST TỰ ĐỘNG DỰA TRÊN LEVEL HIỆN TẠI
local function GetCurrentQuest()
    local level = LP.Data.Level.Value
    local currentQ = QuestData[1]
    for reqLvl, qTable in pairs(QuestData) do
        if level >= reqLvl then
            if reqLvl >= currentQ.LevelReq then
                currentQ = qTable
                currentQ.LevelReq = reqLvl
            end
        end
    end
    return currentQ
end

